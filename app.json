{
  "expo": {
    "name": "mungtrip-frontend",
    "slug": "mungtrip-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mungtrip",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.mungtrip.app",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.mungtrip.app",
      "adaptiveIcon": {
        "backgroundColor": "#FE6A20",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Pretendard-Regular.otf",
            "./assets/fonts/Pretendard-Medium.otf",
            "./assets/fonts/Pretendard-SemiBold.otf",
            "./assets/fonts/Pretendard-Bold.otf",
            "./assets/fonts/Hakgyoansim Dunggeunmiso OTF R.otf",
            "./assets/fonts/Hakgyoansim Dunggeunmiso OTF B.otf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Pretendard",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Pretendard-Regular.otf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Pretendard-Medium.otf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Pretendard-SemiBold.otf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Pretendard-Bold.otf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Hakgyoansim Dunggeunmiso",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Hakgyoansim Dunggeunmiso OTF R.otf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Hakgyoansim Dunggeunmiso OTF B.otf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FE6A20",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "현재 위치를 기준으로 가까운 반려동물 동반 장소를 보여드릴게요."
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bbe03cdd-0552-4bfb-8a1c-eb73a42b4caa"
      }
    },
    "owner": "jeongjinho"
  }
}
