{
  "name": "mungtrip-frontend",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/metro-runtime": "57.0.14",
    "@expo/ui": "~57.0.14",
    "@material-design-icons/svg": "0.14.15",
    "@mj-studio/react-native-naver-map": "^2.9.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "axios": "^1.18.1",
    "css-to-react-native": "^3.2.0",
    "expo": "~57.0.17",
    "expo-build-properties": "^57.0.15",
    "expo-constants": "~57.0.15",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "styled-components": "^6.4.3"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "^1.20.3",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "sharp": "0.35.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "preandroid": "pnpm sync:android",
    "android": "expo run:android",
    "sync:android": "expo prebuild --platform android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "clean:cache": "node ./scripts/clean-build-cache.js",
    "start:clean": "pnpm clean:cache && expo start --clear",
    "test": "jest",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check:branch": "node ./scripts/validate-branch-name.js",
    "check:todos": "node ./scripts/check-todos.js",
    "verify": "pnpm check:branch && pnpm check:todos && pnpm lint && pnpm typecheck",
    "prepare": "node ./scripts/install-git-hooks.js"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "private": true,
  "packageManager": "pnpm@9.6.0"
}
